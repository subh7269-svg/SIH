# TraceX Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=True

# Database Configuration (SQLite default for zero-setup; PostgreSQL for production/docker)
DATABASE_URL=sqlite:///./tracex.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tracex

# Security & Authentication
JWT_SECRET=tracex_investigative_secret_key_sih2026_offline_security
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Ingestion & Storage Limits
UPLOAD_MAX_SIZE_MB=100
DATA_DIR=./data
ML_ARTIFACT_DIR=./ml/artifacts

# Offline GeoIP
GEOIP_OFFLINE_DB_PATH=./backend/app/geoip/data/offline_subnets.json
